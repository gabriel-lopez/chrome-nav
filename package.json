{
  "name": "chrome-nav",
  "version": "0.1.0",
  "description": "CLI to drive a real Chrome instance via CDP (navigate, click, type, inspect DOM/console/network)",
  "private": true,
  "bin": {
    "chrome-nav": "build/app/cli.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf build && node esbuild.config.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
